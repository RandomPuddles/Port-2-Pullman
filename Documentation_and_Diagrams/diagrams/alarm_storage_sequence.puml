@startuml Alarm Storage – Sequence Diagram
title Alarm Storage · Key Sequences

skinparam defaultFontName Roboto
skinparam defaultFontSize 12
skinparam backgroundColor #FAFCFA
skinparam sequenceArrowColor #37474F
skinparam sequenceLifeLineBorderColor #2E7D32

participant "Consumer\n(ViewModel / Service)" as Caller
participant "AlarmRepositoryImpl" as AlarmRepo
participant "ConditionRepositoryImpl" as CondRepo
participant "AlarmDao" as ADao
participant "ConditionDao" as CDao
participant "Moshi" as Moshi
database "Room\nSQLite" as DB

== Load All Alarms (reactive) ==

Caller -> AlarmRepo : getAll()
AlarmRepo -> ADao : getAll()
ADao -> DB : SELECT * FROM alarms
DB --> ADao : Flow<List<AlarmEntity>>
ADao --> AlarmRepo : Flow<List<AlarmEntity>>

loop each entity in Flow emission
  AlarmRepo -> Moshi : fromJson(conditionTreeJson)
  Moshi --> AlarmRepo : Condition (sealed tree)
  AlarmRepo -> AlarmRepo : map to Alarm
end

AlarmRepo --> Caller : Flow<List<Alarm>>

== Upsert Alarm ==

Caller -> AlarmRepo : upsert(alarm)
AlarmRepo -> Moshi : toJson(alarm.rootCondition)
Moshi --> AlarmRepo : conditionTreeJson
note right : Polymorphic Moshi adapter serializes\nsealed Condition tree (Leaf + Composite)
AlarmRepo -> AlarmRepo : build AlarmEntity
AlarmRepo -> ADao : upsert(entity)
ADao -> DB : INSERT OR REPLACE
DB --> ADao : rowId
ADao --> AlarmRepo : rowId: Long
AlarmRepo --> Caller : rowId

note right : Flow observers auto-emit\nupdated list after write

== Bulk Enable / Disable ==

Caller -> AlarmRepo : setEnabled([1, 2, 3], false)
AlarmRepo -> ADao : setEnabled([1, 2, 3], false)
ADao -> DB : UPDATE alarms\nSET enabled = 0\nWHERE id IN (1, 2, 3)
DB --> ADao : done
ADao --> AlarmRepo : Unit
AlarmRepo --> Caller : Unit

== Delete Alarms ==

Caller -> AlarmRepo : delete([4, 5])
AlarmRepo -> ADao : deleteByIds([4, 5])
ADao -> DB : DELETE FROM alarms\nWHERE id IN (4, 5)
DB --> ADao : done
ADao --> AlarmRepo : Unit
AlarmRepo --> Caller : Unit

== Load Categories (built-in + custom) ==

Caller -> CondRepo : getCategories()
CondRepo -> CondRepo : static builtInCategories
CondRepo -> CDao : getAll()
CDao -> DB : SELECT * FROM custom_conditions
DB --> CDao : Flow<List<CustomConditionEntity>>

loop each custom entity
  CondRepo -> Moshi : fromJson(refreshFreqJson)
  Moshi --> CondRepo : RefreshFrequency
  CondRepo -> CondRepo : map to CustomCondition
end

CondRepo -> CondRepo : merge built-in + Custom category
CondRepo --> Caller : Flow<List<Category>>

== Upsert Custom Condition ==

Caller -> CondRepo : upsertCustom(customCondition)
CondRepo -> Moshi : toJson(refreshFrequency)
Moshi --> CondRepo : refreshFreqJson
CondRepo -> CondRepo : build CustomConditionEntity
CondRepo -> CDao : upsert(entity)
CDao -> DB : INSERT OR REPLACE
DB --> CDao : done
CondRepo --> Caller : Unit

@enduml
