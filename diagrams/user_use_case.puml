@startuml User Use Case Diagram
top to bottom direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor User

rectangle "Conditional Alarms" {

  ' === Row 1: Alarm Management + AI ===
  together {
    package "Alarm Management" {
      usecase "Browse Alarms" as UC_Browse
      usecase "Search Alarms\nby Title / Condition" as UC_Search
      usecase "Create Alarm" as UC_Create
      usecase "Edit Alarm" as UC_Edit
      usecase "Enable/Disable Alarm" as UC_Toggle
    }

    package "AI Features" {
      usecase "Create Alarm via\nAI Prompt" as UC_AI
    }
  }

  ' === Row 2: Alarm Setup ===
  package "Alarm Setup" {
    usecase "Enter Alarm Title" as UC_Title
    usecase "Add Condition" as UC_AddCond
    usecase "Modify Condition" as UC_ModifyCond
    usecase "Remove Condition" as UC_RemoveCond
    usecase "Set Boolean Operator\n(AND / OR)" as UC_Bool
    usecase "Set Numerical Value\nin Condition" as UC_NumVal
    usecase "Enable Readout\n(TTS reads title aloud)" as UC_Readout
    usecase "Enable Ring\n(Alarm sound)" as UC_Ring
    usecase "Set Trigger Once" as UC_Once
  }

  ' === Row 3: Condition Selection ===
  package "Condition Selection" {
    usecase "Browse Condition Categories" as UC_BrowseCat
    usecase "Select Condition\nfrom Category" as UC_SelCond
    usecase "Create Custom Condition" as UC_CreateCustom
    usecase "Enter Custom Condition Title" as UC_CustomTitle
    usecase "Enter Condition Statement" as UC_CustomStmt
    usecase "Modify Custom Condition" as UC_ModifyCustom
    usecase "Delete Custom Condition" as UC_DeleteCustom
  }

  note right of UC_BrowseCat
    Categories include:
    - Weather
    - Device Attributes
    - Time / Date
    - Location
    - Recurring Schedule
  end note

  note right of UC_CreateCustom
    Custom conditions are saved to
    a "Custom" category, available
    for selection in future alarms.
  end note

  note right of UC_ModifyCustom
    Only user-created custom
    conditions can be modified
    or deleted.
  end note

  ' --- Relationships ---

  User --> UC_Browse
  User --> UC_Create
  User --> UC_Toggle
  User --> UC_AI

  UC_Browse ..> UC_Search : <<extend>>
  UC_Browse ..> UC_Toggle : <<extend>>
  UC_Browse ..> UC_Edit : <<extend>>

  UC_Create ..> UC_Title : <<include>>
  UC_Create ..> UC_AddCond : <<include>>
  UC_Create ..> UC_Readout : <<extend>>
  UC_Create ..> UC_Ring : <<extend>>
  UC_Create ..> UC_Once : <<extend>>

  UC_Edit ..> UC_Title : <<extend>>
  UC_Edit ..> UC_AddCond : <<extend>>
  UC_Edit ..> UC_ModifyCond : <<extend>>
  UC_Edit ..> UC_RemoveCond : <<extend>>
  UC_Edit ..> UC_Readout : <<extend>>
  UC_Edit ..> UC_Ring : <<extend>>
  UC_Edit ..> UC_Once : <<extend>>

  UC_AddCond ..> UC_BrowseCat : <<include>>
  UC_ModifyCond ..> UC_Bool : <<extend>>
  UC_ModifyCond ..> UC_NumVal : <<extend>>
  UC_ModifyCond ..> UC_BrowseCat : <<extend>>
  UC_BrowseCat ..> UC_SelCond : <<include>>
  UC_BrowseCat ..> UC_CreateCustom : <<extend>>
  UC_BrowseCat ..> UC_ModifyCustom : <<extend>>
  UC_BrowseCat ..> UC_DeleteCustom : <<extend>>
  UC_CreateCustom ..> UC_CustomTitle : <<include>>
  UC_CreateCustom ..> UC_CustomStmt : <<include>>
}

@enduml
