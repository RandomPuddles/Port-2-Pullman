@startuml Conditional Alarms – Simple Component Diagram
title Conditional Alarms · Component Overview

skinparam defaultFontName  Roboto
skinparam defaultFontSize  13
skinparam componentStyle   rectangle
skinparam ArrowColor       #336699
skinparam ArrowFontSize    11

skinparam package {
  BackgroundColor #F0F4F8
  BorderColor     #5C8A8A
  FontStyle       bold
  FontSize        14
}
skinparam component {
  BackgroundColor #DDEEFF
  BorderColor     #336699
}
skinparam note {
  BackgroundColor #FAFAFA
  BorderColor     #AAAAAA
  FontSize        11
}

' ═══════════════════════════════════════════════
'  ROW 1 – UI Screens
' ═══════════════════════════════════════════════

package "Home Screen" as PKG_HOME {
  component [Alarm List\n─────────────\nBrowse · Search · Enable / Disable\nSelect mode (bulk toggle / delete)\nCreate (+) · Edit (tap) · AI (sparkle)] as AlarmList
}

package "Alarm Setup" as PKG_SETUP {
  component [Alarm Editor\n─────────────\nTitle · Condition blocks\nBool operators (AND / OR)\nNumerical value · Drag reorder\nReadout · Ring · Trigger Once] as AlarmEditor
}

package "Condition Browser" as PKG_BROWSER {
  component [Category Grid & Picker\n─────────────\nWeather · Device · Time / Date\nLocation · Schedule · Custom\nTap condition → return to Setup] as CondPicker
  component [Custom Condition Editor\n─────────────\nTitle · Statement · Refresh Freq\nCreate · Modify · Delete] as CustomEditor
}

' ═══════════════════════════════════════════════
'  ROW 2 – AI · Storage · Engine
' ═══════════════════════════════════════════════

package "AI Alarm Creator" as PKG_AI {
  component [AI Prompt\n─────────────\nFree-text prompt\n→ alarm draft for review] as AIPrompt
}

package "Alarm Storage" as PKG_STORAGE {
  component [Alarm Repository\n─────────────\nSave · Load · Delete alarms\nEnable / Disable (single & bulk)\nPersist condition order] as AlarmRepo
  component [Condition Repository\n─────────────\nBuilt-in category catalogue\nCustom condition CRUD] as CondRepo
}

package "Alarm Engine  (background)" as PKG_ENGINE {
  component [Condition Evaluator\n─────────────\nPer-type checks:\nWeather · Device · Time\nLocation · Schedule · Custom\nRespects AND / OR] as Evaluator
  component [Notification Controller\n─────────────\nPing · Ring · Readout (TTS)\nTrigger Once → auto-disable] as Notifier
}

' ═══════════════════════════════════════════════
'  LAYOUT GUIDES
' ═══════════════════════════════════════════════

PKG_HOME    -[hidden]right- PKG_SETUP
PKG_SETUP   -[hidden]right- PKG_BROWSER
PKG_AI      -[hidden]right- PKG_STORAGE
PKG_STORAGE -[hidden]right- PKG_ENGINE
PKG_HOME    -[hidden]down-  PKG_AI
PKG_SETUP   -[hidden]down-  PKG_STORAGE
PKG_BROWSER -[hidden]down-  PKG_ENGINE

' ═══════════════════════════════════════════════
'  CONNECTIONS
' ═══════════════════════════════════════════════

' Home ↔ Setup
AlarmList   -right->  AlarmEditor : create / edit alarm

' Home → Storage
AlarmList   -down->   AlarmRepo   : load · search · toggle · delete

' Setup → Storage
AlarmEditor -down->   AlarmRepo   : save / update alarm

' Setup ↔ Browser
AlarmEditor -right->  CondPicker  : + add condition
CondPicker  -left->   AlarmEditor : return selected condition

' Browser → Storage
CondPicker   -down->  CondRepo    : load categories
CustomEditor -down->  CondRepo    : create / modify / delete

' Browser internal
CondPicker -down-> CustomEditor   : open editor (Custom category)

' AI flow
AlarmList -down->  AIPrompt       : open AI prompt
AIPrompt  -right-> AlarmEditor    : pass draft for review

' Engine flow
Evaluator -left->  AlarmRepo      : observe enabled alarms\nauto-disable trigger-once
Evaluator -right-> Notifier       : trigger on match

' ═══════════════════════════════════════════════
'  NOTES
' ═══════════════════════════════════════════════

note bottom of CustomEditor
  Only custom conditions can be
  modified or deleted. Saved to
  "Custom" category for reuse.
end note

note bottom of Notifier
  If both Ring and Readout are on,
  TTS plays after Ring is dismissed.
end note

@enduml
