@startuml Component Architecture – Conditional Alarms

title Conditional Alarms · Component Architecture
caption Kotlin · Jetpack Compose · Coroutines / Flow · Room · Moshi · DataStore · Ktor Client · Gemini SDK

skinparam componentStyle rectangle
skinparam defaultFontName  Roboto
skinparam defaultFontSize  12
skinparam backgroundColor  #FAFCFA

skinparam component {
  BackgroundColor #E8F5E9
  BorderColor     #2E7D32
}
skinparam interface {
  BackgroundColor #C8E6C9
  BorderColor     #2E7D32
}
skinparam package {
  BackgroundColor #F1F8E9
  BorderColor     #66BB6A
  FontStyle       bold
  FontSize        13
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor     #FBC02D
  FontSize        10
}
skinparam ArrowColor    #37474F
skinparam ArrowFontSize 10

' ═══════════════════════════════════════════════
'  SHARED INTERFACES (the only cross-package contracts)
' ═══════════════════════════════════════════════

interface "IAlarmRepository" as IAlarmRepo
interface "IConditionRepository" as ICondRepo

' ═══════════════════════════════════════════════
'  ROW 1 – UI Screens
' ═══════════════════════════════════════════════

package "Home Screen  (Compose)" as PKG_HOME {
  component [HomeScreen\n──────────\nAlarm list · Search bar\nSelect mode (bulk toggle / delete)\nFAB (+) · AI sparkle button] as HomeScreen
  component [AlarmListViewModel\n──────────────────\nStateFlow<List<Alarm>>\nsearch · setEnabled · delete] as HomeVM
}

package "Alarm Setup  (Compose)" as PKG_SETUP {
  component [SetupScreen\n──────────\nTitle field · Condition blocks\nBool-op chips · Num-value badge\nDrag-to-reorder · Options toggles\nReviews AI-generated drafts] as SetupScreen
  component [SetupViewModel\n─────────────\nStateFlow<AlarmDraft>\nupsert alarm] as SetupVM
}

package "Condition Browser  (Compose)" as PKG_BROWSER {
  component [CategoryScreen\n─────────────\nCategory grid:\nWeather · Device · Time\nLocation · Schedule · Custom] as CatScreen
  component [ConditionPickerScreen\n────────────────────\nConditions within a category\nTap → returns to Setup] as PickerScreen
  component [CustomConditionDialog\n────────────────────\nTitle · Statement · Refresh Freq\nCreate · Modify · Delete] as CustomDialog
  component [ConditionBrowserViewModel\n────────────────────────\nStateFlow<List<Category>>\ncustom condition CRUD] as BrowserVM
}

' ═══════════════════════════════════════════════
'  ROW 2 – AI · Storage · Engine
' ═══════════════════════════════════════════════

package "AI Alarm Creator  (Compose · Gemini SDK)" as PKG_AI {
  component [AIPromptDialog\n──────────────\nFree-text prompt input\nSubmit → generates draft] as AIDialog
  component [AIViewModel\n──────────\nGenerativeModel (Gemini 1.5 Pro)\nMoshi → Result<AlarmDraft>\nNavigates to Setup with draft] as AIVM
}

package "Alarm Storage  (Room · Moshi · DataStore)" as PKG_STORAGE {
  component [AlarmRepositoryImpl\n──────────────────\nRoom + Flow · upsert / delete\nbulk setEnabled\nMoshi: condition tree ↔ JSON] as AlarmRepoImpl
  component [ConditionRepositoryImpl\n─────────────────────\nBuilt-in: static list\nCustom: Room + Flow\nRefreshFreq via Moshi] as CondRepoImpl
  component [RoomDatabase\n────────────\nalarms · custom_conditions\nAlarmDao · ConditionDao] as RoomDB
}

package "Alarm Engine  (Service · Coroutines · Ktor)" as PKG_ENGINE {
  component [AlarmEvaluatorService\n─────────────────────\nForeground Service\nCoroutine per enabled alarm\nAND / OR operator logic\nRecursive tree evaluation] as EvalSvc
  component [ConditionEvaluators\n───────────────────\nStrategy per type:\nWeather · Device · Time\nLocation · Schedule · Custom] as CondEvals
  component [NotificationController\n────────────────────\nRing → MediaPlayer loop\nReadout → TextToSpeech\nPing → NotificationCompat] as NotifCtrl
  component [ExternalDataFetcher\n───────────────────\nKtor GET: Weather · Location\nCached per refreshFreq] as ExtFetch
}

' ═══════════════════════════════════════════════
'  LAYOUT GUIDES  (hidden arrows enforce 3×2 grid)
' ═══════════════════════════════════════════════

PKG_HOME    -[hidden]right- PKG_SETUP
PKG_SETUP   -[hidden]right- PKG_BROWSER
PKG_AI      -[hidden]right- PKG_STORAGE
PKG_STORAGE -[hidden]right- PKG_ENGINE
PKG_HOME    -[hidden]down-  PKG_AI
PKG_SETUP   -[hidden]down-  PKG_STORAGE
PKG_BROWSER -[hidden]down-  PKG_ENGINE

' ═══════════════════════════════════════════════
'  INTERFACE IMPLEMENTATIONS  (provided)
' ═══════════════════════════════════════════════

AlarmRepoImpl -up- IAlarmRepo
CondRepoImpl  -up- ICondRepo

' ═══════════════════════════════════════════════
'  INTERFACE CONSUMERS  (required)
' ═══════════════════════════════════════════════

HomeVM    ..> IAlarmRepo : browse · search\ntoggle · delete
SetupVM   ..> IAlarmRepo : save · load
EvalSvc   ..> IAlarmRepo : observe enabled\ndisable trigger-once
BrowserVM ..> ICondRepo  : categories\ncustom CRUD

' ═══════════════════════════════════════════════
'  INTERNAL WIRING  (within packages)
' ═══════════════════════════════════════════════

AlarmRepoImpl ..> RoomDB : DAO
CondRepoImpl  ..> RoomDB : DAO
EvalSvc   ..> CondEvals  : evaluate
EvalSvc   ..> NotifCtrl  : trigger
CondEvals ..> ExtFetch   : fetch data

' ═══════════════════════════════════════════════
'  NAVIGATION FLOW  (cross-package UI routes)
' ═══════════════════════════════════════════════

HomeScreen   -right->  SetupScreen  : create / edit alarm
HomeScreen   -down->   AIDialog     : open AI prompt
SetupScreen  -right->  CatScreen    : + add condition
PickerScreen -left->   SetupScreen  : return selected condition
AIVM         -up->     SetupScreen  : pass AlarmDraft for review

' ═══════════════════════════════════════════════
'  NOTES
' ═══════════════════════════════════════════════

note bottom of IAlarmRepo
  **IAlarmRepository**
  ────────────────────────
  + getAll(): Flow<List<Alarm>>
  + search(q: String): Flow<List<Alarm>>
  + getById(id: Long): Flow<Alarm?>
  + upsert(alarm: Alarm): suspend Long
  + delete(ids: List<Long>): suspend Unit
  + setEnabled(ids: List<Long>,
      on: Boolean): suspend Unit
  ────────────────────────
  · setEnabled accepts List for both
    single-toggle and bulk select-mode
  · Alarm stores rootCondition as a
    polymorphic JSON tree via Moshi
    (sealed Condition → LeafCondition
    + CompositeCondition)
  · Flow keeps UI reactive
end note

note bottom of ICondRepo
  **IConditionRepository**
  ────────────────────────
  + getCategories(): Flow<List<Category>>
  + upsertCustom(c: CustomCondition):
      suspend Unit
  + deleteCustom(id: Long): suspend Unit
  ────────────────────────
  · Combines static built-in categories
    with dynamic Custom category (Room)
  · RefreshFrequency stored as JSON
  · Only the Condition Browser depends
    on this interface
end note

note bottom of RoomDB
  **Room Schema**
  ────────────────────────
  AlarmEntity:
    id · title · conditionTreeJson
    readout · ring · triggerOnce
    enabled
  CustomConditionEntity:
    id · title · statement
    refreshFreqJson
end note

note bottom of NotifCtrl
  Ring + Readout → TTS plays after
  Ring is dismissed. Trigger Once →
  auto-disable via IAlarmRepository.
end note

note bottom of AIVM
  GenerativeModel (gemini-1.5-pro)
  generateContent(prompt) → text
  Moshi parses JSON → AlarmDraft
  Draft passed as Compose navigation
  arg (Moshi-serialized) to Setup.
  API key in secrets.properties.
end note

@enduml
