@startuml Alarm Storage – Class Diagram
title Alarm Storage · Class Diagram

skinparam defaultFontName Roboto
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam backgroundColor #FAFCFA

skinparam class {
  BackgroundColor #E8F5E9
  BorderColor     #2E7D32
  HeaderBackgroundColor #C8E6C9
}

' ───────────────────────────────────
'  Interfaces (provided to other packages)
' ───────────────────────────────────

interface IAlarmRepository <<interface>> {
  + getAll(): Flow<List<Alarm>>
  + search(q: String): Flow<List<Alarm>>
  + getById(id: Long): Flow<Alarm?>
  + upsert(alarm: Alarm): suspend Long
  + delete(ids: List<Long>): suspend Unit
  + setEnabled(ids: List<Long>, on: Boolean): suspend Unit
}

interface IConditionRepository <<interface>> {
  + getCategories(): Flow<List<Category>>
  + upsertCustom(c: CustomCondition): suspend Unit
  + deleteCustom(id: Long): suspend Unit
}

' ───────────────────────────────────
'  Repository Implementations
' ───────────────────────────────────

class AlarmRepositoryImpl {
  - alarmDao : AlarmDao
  - moshi : Moshi
  --
  + getAll(): Flow<List<Alarm>>
  + search(q: String): Flow<List<Alarm>>
  + getById(id: Long): Flow<Alarm?>
  + upsert(alarm: Alarm): suspend Long
  + delete(ids: List<Long>): suspend Unit
  + setEnabled(ids: List<Long>, on: Boolean): suspend Unit
  --
  - toEntity(alarm: Alarm): AlarmEntity
  - toDomain(entity: AlarmEntity): Alarm
}

class ConditionRepositoryImpl {
  - conditionDao : ConditionDao
  - builtInCategories : List<Category>
  - moshi : Moshi
  --
  + getCategories(): Flow<List<Category>>
  + upsertCustom(c: CustomCondition): suspend Unit
  + deleteCustom(id: Long): suspend Unit
  --
  - toEntity(c: CustomCondition): CustomConditionEntity
  - toDomain(e: CustomConditionEntity): CustomCondition
}

' ───────────────────────────────────
'  Room Database
' ───────────────────────────────────

abstract class AppDatabase <<@Database>> {
  + alarmDao(): AlarmDao
  + conditionDao(): ConditionDao
}

interface AlarmDao <<@Dao>> {
  + getAll(): Flow<List<AlarmEntity>>
  + search(q: String): Flow<List<AlarmEntity>>
  + getById(id: Long): Flow<AlarmEntity?>
  + upsert(entity: AlarmEntity): Long
  + deleteByIds(ids: List<Long>)
  + setEnabled(ids: List<Long>, on: Boolean)
}

interface ConditionDao <<@Dao>> {
  + getAll(): Flow<List<CustomConditionEntity>>
  + upsert(entity: CustomConditionEntity)
  + deleteById(id: Long)
}

' ───────────────────────────────────
'  Room Entities
' ───────────────────────────────────

class AlarmEntity <<@Entity>> {
  + id : Long  <<PK>>
  + title : String
  + conditionsJson : String
  + operatorsJson : String
  + readout : Boolean
  + ring : Boolean
  + triggerOnce : Boolean
  + enabled : Boolean
}

class CustomConditionEntity <<@Entity>> {
  + id : Long  <<PK>>
  + title : String
  + statement : String
  + refreshFreqJson : String
}

' ───────────────────────────────────
'  Moshi Adapters
' ───────────────────────────────────

class MoshiModule {
  + provideMoshi(): Moshi
}

class ConditionListAdapter <<@JsonAdapter>> {
  + toJson(conditions: List<Condition>): String
  + fromJson(json: String): List<Condition>
}

class OperatorListAdapter <<@JsonAdapter>> {
  + toJson(ops: List<Operator>): String
  + fromJson(json: String): List<Operator>
}

class RefreshFrequencyAdapter <<@JsonAdapter>> {
  + toJson(freq: RefreshFrequency): String
  + fromJson(json: String): RefreshFrequency
}

' ───────────────────────────────────
'  Relationships
' ───────────────────────────────────

IAlarmRepository <|.. AlarmRepositoryImpl : implements
IConditionRepository <|.. ConditionRepositoryImpl : implements

AlarmRepositoryImpl --> AlarmDao : uses
ConditionRepositoryImpl --> ConditionDao : uses
AlarmRepositoryImpl --> MoshiModule : JSON conversion
ConditionRepositoryImpl --> MoshiModule : JSON conversion

AppDatabase ..> AlarmDao : provides
AppDatabase ..> ConditionDao : provides

AlarmDao ..> AlarmEntity : CRUD
ConditionDao ..> CustomConditionEntity : CRUD

MoshiModule ..> ConditionListAdapter : registers
MoshiModule ..> OperatorListAdapter : registers
MoshiModule ..> RefreshFrequencyAdapter : registers

@enduml
