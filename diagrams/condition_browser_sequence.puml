@startuml Condition Browser – Sequence Diagram
title Condition Browser · Key Sequences

skinparam defaultFontName Roboto
skinparam defaultFontSize 12
skinparam backgroundColor #FAFCFA
skinparam sequenceArrowColor #37474F
skinparam sequenceLifeLineBorderColor #2E7D32

actor User
participant "CategoryScreen" as CatUI
participant "ConditionPickerScreen" as PickUI
participant "CustomConditionDialog" as DlgUI
participant "ConditionBrowserViewModel" as VM
participant "IConditionRepository" as Repo

== Browse Condition Categories ==

CatUI -> VM : collect(categories)
activate VM
VM -> Repo : getCategories()
Repo --> VM : Flow<List<Category>>
note right : Built-in: Weather, Device,\nTime/Date, Location, Schedule\nDynamic: Custom (Room)
VM --> CatUI : StateFlow<List<Category>>
deactivate VM

== Select Condition from Category ==

User -> CatUI : tap "Weather"
CatUI -> PickUI : navigate(category = Weather)
PickUI -> PickUI : display conditions in category

User -> PickUI : tap "Temperature > X"
PickUI -> PickUI : return LeafCondition to SetupScreen\nvia Compose navigation result

== Create Custom Condition ==

User -> CatUI : tap "Custom" category
CatUI -> PickUI : navigate(category = Custom)
User -> PickUI : tap "+" create button
PickUI -> DlgUI : open dialog (create mode)

User -> DlgUI : enter title
User -> DlgUI : enter statement
User -> DlgUI : set refresh freq (10, MINUTES)
User -> DlgUI : tap Save

DlgUI -> VM : upsertCustom(customCondition)
activate VM
VM -> Repo : upsertCustom(customCondition)
Repo --> VM : Unit
note right : Flow re-emits categories\nwith updated Custom list
deactivate VM

== Modify Custom Condition ==

User -> PickUI : long-press custom condition
PickUI -> DlgUI : open dialog (edit mode)
User -> DlgUI : change statement
User -> DlgUI : tap Save
DlgUI -> VM : upsertCustom(updatedCondition)
VM -> Repo : upsertCustom(updatedCondition)
Repo --> VM : Unit

== Delete Custom Condition ==

User -> PickUI : long-press custom condition
PickUI -> DlgUI : open dialog (edit mode)
User -> DlgUI : tap Delete
DlgUI -> DlgUI : show confirmation
User -> DlgUI : confirm
DlgUI -> VM : deleteCustom(id)
VM -> Repo : deleteCustom(id)
Repo --> VM : Unit

@enduml
